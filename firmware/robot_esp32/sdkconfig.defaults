CONFIG_IDF_TARGET="esp32"
# Consola por la UART0 (GPIO1/GPIO3), que en la DevKit va al chip USB-serie
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# Tick de 1 ms para un lazo de control de 5 ms preciso
CONFIG_FREERTOS_HZ=1000
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Si el lazo de control se traba más de 3 s, el ESP se reinicia (y los motores se apagan)
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=3
